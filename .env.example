# Backend
HOST=127.0.0.1
PORT=8000
FLASK_DEBUG=1
BLUETITS_DB=./bluetits.sqlite3
PRIVY_APP_ID=cmtvduxb801d80bl8rg0vb7km
# Copy the public verification key from Privy Dashboard -> App settings.
# A literal multiline PEM value also works.
PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"

# Frontend dev server
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
BLUETITS_BACKEND_URL=http://127.0.0.1:8000

# Set these only when the browser talks to the API directly instead of using
# the Vite proxy. Multiple origins are comma-separated.
BLUETITS_FRONTEND_ORIGINS=http://127.0.0.1:5173

# Frontend production build (empty means same-origin /api or a dev proxy)
VITE_API_URL=
